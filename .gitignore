__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
outputs/*
!outputs/.gitkeep
# Curated paper-writing bundle (figures/tables/notes); keep logs out.
!outputs/paper_bundle/
!outputs/paper_bundle/**
outputs/paper_bundle/nohup.log
outputs/paper_bundle/run_log.txt
outputs/paper_bundle/*.log
# Keep only PNG in the tracked bundle to limit repo size.
outputs/paper_bundle/figures/*.pdf
outputs/paper_bundle/figures/*.svg
# N=1500 / SNR=20 dB curated slice (paper_bundle + meta only; reports stay local).
!outputs/n1500_snr20_bundle/
outputs/n1500_snr20_bundle/*
!outputs/n1500_snr20_bundle/README.md
!outputs/n1500_snr20_bundle/meta/
!outputs/n1500_snr20_bundle/meta/**
!outputs/n1500_snr20_bundle/paper_bundle/
!outputs/n1500_snr20_bundle/paper_bundle/**
outputs/n1500_snr20_bundle/paper_bundle/figures/*.pdf
outputs/n1500_snr20_bundle/paper_bundle/figures/*.svg
*.npz
.DS_Store

# Secrets / credentials (defense in depth before public repo)
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
credentials.json
secrets.*

# Local tooling / IDE
.cursor/
.idea/
.vscode/

# Logs
*.log
